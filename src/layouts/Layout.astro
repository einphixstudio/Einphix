---
import '@fontsource/hanken-grotesk/300.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  /** Locks body to the viewport height instead of growing with content — for single-screen pages like the home carousel. */
  fitViewport?: boolean;
}

const { title, fitViewport = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class={fitViewport ? 'fit-viewport' : undefined}>
    <slot />
  </body>
</html>
