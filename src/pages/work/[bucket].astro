---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import YearSwitcher from '../../components/YearSwitcher.astro';
import WorkRail from '../../components/WorkRail.astro';
import { YEAR_BUCKETS, getWorksForBucket } from '../../lib/workBuckets';

export async function getStaticPaths() {
  return Promise.all(
    YEAR_BUCKETS.map(async (bucket) => ({
      params: { bucket: bucket.slug },
      props: { bucket, works: await getWorksForBucket(bucket) },
    })),
  );
}

const { bucket, works } = Astro.props;
---

<Layout title={`Einphix — Work / ${bucket.label}`} fitViewport>
  <SiteHeader />
  <main>
    <YearSwitcher currentSlug={bucket.slug} />
    {works.length > 0 && <WorkRail works={works} />}
  </main>
</Layout>

<style>
  main {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    cursor: grab;
  }
  main:global(.dragging) {
    cursor: grabbing;
  }
</style>
