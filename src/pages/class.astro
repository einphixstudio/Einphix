---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getClassSetting, getSupplies, getColors, getFaq } from '../lib/classPage';

const [suppliesHeading, acrylicIntro, acrylicName, acrylicNote, acrylicImage, colorsHeading, faqHeading] =
  await Promise.all([
    getClassSetting('suppliesHeading'),
    getClassSetting('acrylicIntro'),
    getClassSetting('acrylicName'),
    getClassSetting('acrylicNote'),
    getClassSetting('acrylicImage'),
    getClassSetting('colorsHeading'),
    getClassSetting('faqHeading'),
  ]);
const [supplies, colors, faq] = await Promise.all([getSupplies(), getColors(), getFaq()]);
---

<Layout title="Einphix — Class">
  <SiteHeader current="class" />
  <main class="cl">
    <section class="intro">
      <h1>Class</h1>
    </section>

    {faq.length > 0 && (
      <section class="faq">
        {faqHeading && <h2>{faqHeading}</h2>}
        <div class="faq-list">
          {faq.map((f) => (
            <details>
              <summary>
                <span>{f.question}</span>
                <span class="plus">+</span>
              </summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="supplies">
      {suppliesHeading && <h2>{suppliesHeading}</h2>}

      {supplies.length > 0 && (
        <div class="supplies-grid">
          {supplies.map((item) => (
            <div class="supply-card">
              <div class="thumb">
                {item.imageExt ? (
                  <img src={`/class-supplies/${item.id}.${item.imageExt}`} alt={item.name} />
                ) : (
                  <span class="placeholder">Photo coming soon</span>
                )}
              </div>
              <h3>{item.name}</h3>
              {item.description && <p class="desc">{item.description}</p>}
              {item.link && (
                <a class="buy-link" href={item.link} target="_blank" rel="noopener noreferrer">
                  Amazon 购买链接
                </a>
              )}
            </div>
          ))}
        </div>
      )}

      {acrylicName && (
        <div class="acrylic">
          {acrylicIntro && <p class="acrylic-intro">{acrylicIntro}</p>}
          <div class="acrylic-card">
            <div class="thumb">
              {acrylicImage ? (
                <img src={`/class-supplies/${acrylicImage}`} alt={acrylicName} />
              ) : (
                <span class="placeholder">Photo coming soon</span>
              )}
            </div>
            <div class="acrylic-copy">
              <h3>{acrylicName}</h3>
              {acrylicNote && <p class="desc">{acrylicNote}</p>}
              {colors.length > 0 && (
                <>
                  {colorsHeading && <h4>{colorsHeading}</h4>}
                  <ul class="colors">
                    {colors.map((c) => (
                      <li>
                        {c.name}
                        {c.note && <span class="note"> （{c.note}）</span>}
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </div>
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  main.cl {
    flex: 1 1 auto;
  }
  main.cl > section {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 80px) var(--pad-x);
  }
  main.cl > section + section {
    border-top: 1px solid var(--rule);
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 400;
    color: var(--ink);
  }

  .supplies h2,
  .faq h2 {
    margin: 0 0 28px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .supplies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: clamp(24px, 3vw, 36px);
  }
  .thumb {
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--frame-bg);
    overflow: hidden;
    margin-bottom: 14px;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .thumb .placeholder {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--meta);
    text-align: center;
    padding: 0 12px;
  }
  .supply-card h3 {
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .supply-card .desc {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--meta);
    white-space: pre-line;
  }
  .buy-link {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 180ms;
  }
  .buy-link:hover {
    opacity: 0.65;
  }

  .acrylic {
    margin-top: clamp(48px, 6vw, 72px);
  }
  .acrylic-intro {
    margin: 0 0 24px;
    padding: 14px 18px;
    font-size: 14px;
    color: var(--ink);
    background: oklch(0.94 0.03 80);
    border-left: 2px solid var(--ink);
  }
  .acrylic-card {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 4vw, 40px);
  }
  .acrylic-card .thumb {
    flex: 0 0 auto;
    width: clamp(180px, 24vw, 260px);
    margin-bottom: 0;
  }
  .acrylic-copy {
    flex: 1 1 280px;
  }
  .acrylic-copy h3 {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
  }
  .acrylic-copy .desc {
    margin: 0 0 20px;
    font-size: 13px;
    color: var(--meta);
  }
  .acrylic-copy h4 {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .colors {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .colors li {
    font-size: 14px;
    color: var(--ink);
  }
  .colors .note {
    color: var(--meta);
    font-size: 13px;
  }

  /* ---------- FAQ ---------- */
  .faq-list {
    display: flex;
    flex-direction: column;
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  details:first-child {
    border-top: 1px solid var(--rule);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary .plus {
    flex: 0 0 auto;
    font-size: 18px;
    font-weight: 400;
    color: var(--meta);
    transition: transform 220ms;
  }
  details[open] summary .plus {
    transform: rotate(45deg);
  }
  details p {
    margin: 0 0 22px;
    max-width: 70ch;
    font-size: 14px;
    line-height: 1.7;
    color: var(--meta);
    white-space: pre-line;
  }
</style>
