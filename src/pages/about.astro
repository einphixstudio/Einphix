---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Picture } from 'astro:assets';
import { getAboutPhoto, getSetting, getParagraphs } from '../lib/about';

const photo = await getAboutPhoto();
const heading = (await getSetting('heading')) ?? 'About Me';
const paragraphs = await getParagraphs();
---

<Layout title="Einphix — About">
  <SiteHeader current="about" />
  <main>
    <div class="about">
      <div class="portrait">
        {photo ? (
          <Picture
            src={photo}
            alt={heading}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={700}
            loading="eager"
          />
        ) : (
          <div class="missing">Image missing</div>
        )}
      </div>
      <div class="copy">
        <h1>{heading}</h1>
        {paragraphs.map((text) => (
          <p>{text}</p>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    flex: 1 1 auto;
    display: flex;
    justify-content: center;
    padding: clamp(40px, 6vw, 90px) var(--pad-x) clamp(60px, 8vw, 120px);
  }
  .about {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
    width: 100%;
    max-width: 1200px;
  }
  .portrait {
    flex: 0 0 auto;
    width: clamp(220px, 32vw, 380px);
    aspect-ratio: 4 / 5;
    border-radius: 50%;
    overflow: hidden;
    background: var(--frame-bg);
  }
  .portrait :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .portrait .missing {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--meta);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
  }
  .copy {
    flex: 1 1 360px;
    min-width: 280px;
  }
  h1 {
    margin: 0 0 clamp(20px, 3vw, 32px);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 400;
    color: var(--ink);
  }
  p {
    margin: 0 0 20px;
    max-width: 640px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--meta);
  }
  p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .about {
      flex-direction: column;
      align-items: flex-start;
    }
    .portrait {
      width: min(280px, 70vw);
    }
  }
</style>
