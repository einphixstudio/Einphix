---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import { getSetting, isPromoActive, getPricingRows, getSteps, getAddons } from '../lib/commission';

const [heroHeading, heroSubtext, heroImageId, showPromo, promoText, pricingIntro, depositText] =
  await Promise.all([
    getSetting('heroHeading'),
    getSetting('heroSubtext'),
    getSetting('heroImageId'),
    isPromoActive(),
    getSetting('promoText'),
    getSetting('pricingIntro'),
    getSetting('depositText'),
  ]);
const [pricing, steps, addons] = await Promise.all([getPricingRows(), getSteps(), getAddons()]);
const heroWork = heroImageId ? await getEntry('works', heroImageId) : undefined;

const currency = (n: number) => `$${n.toLocaleString('en-US')}`;
---

<Layout title="Einphix — Commission">
  <SiteHeader current="commission" />
  <main class="cm">
    <section class="hero">
      <div class="copy">
        {heroHeading && <h1>{heroHeading}</h1>}
        {heroSubtext && <p>{heroSubtext}</p>}
      </div>
      {heroWork && (
        <div class="portrait">
          <Picture
            src={heroWork.data.image}
            alt={heroWork.data.title}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            width={700}
            loading="eager"
          />
        </div>
      )}
    </section>

    <section class="pricing">
      <h2>Pricing</h2>
      {pricingIntro && <p class="intro">{pricingIntro}</p>}

      {showPromo && promoText && <p class="promo">{promoText}</p>}

      {pricing.length > 0 && (
        <div class="price-cards">
          <div class="price-card">
            <h3>Pet Portrait</h3>
            <ul>
              {pricing.map((row) => (
                <li>
                  <span class="size">{row.size}"</span>
                  <span class="price">{currency(row.animal)}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="price-card">
            <h3>Human Portrait</h3>
            <ul>
              {pricing.map((row) => (
                <li>
                  <span class="size">{row.size}"</span>
                  <span class="price">{currency(row.portrait)}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}

      {addons.length > 0 && (
        <div class="addons">
          <h3>Add-ons</h3>
          <div class="addons-grid">
            {addons.map((a) => (
              <div class="addon">
                <span class="label">{a.label}</span>
                <span class="desc">{a.description}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {depositText && <p class="note">{depositText}</p>}
    </section>

    <section class="steps">
      <h2>How It Works</h2>
      <div class="timeline">
        {steps.map((s) => (
          <div class="row">
            <div class="num-col">
              <span class="num">{s.step}</span>
              <span class="num-line"></span>
            </div>
            <div class="content-col">
              {s.blocks.map((b) => (
                <div class="block">
                  <h3>{b.title}</h3>
                  <p>{b.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  main.cm {
    flex: 1 1 auto;
  }
  main.cm > section {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(50px, 7vw, 90px) var(--pad-x);
  }
  main.cm > section + section {
    border-top: 1px solid var(--rule);
  }

  /* ---------- hero ---------- */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }
  .hero .copy {
    flex: 1 1 320px;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
  }
  .hero .copy p {
    margin: 16px 0 0;
    max-width: 34ch;
    font-size: 14px;
    line-height: 1.65;
    color: var(--meta);
  }
  .hero .portrait {
    flex: 0 0 auto;
    width: clamp(220px, 30vw, 340px);
    aspect-ratio: 4 / 5;
    border-radius: 50%;
    overflow: hidden;
    background: var(--frame-bg);
  }
  .hero .portrait :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---------- shared section labels ---------- */
  .pricing h2,
  .steps h2 {
    margin: 0 0 20px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .pricing .intro {
    margin: 0 0 24px;
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.65;
    color: var(--meta);
  }
  .promo {
    margin: 0 0 28px;
    padding: 14px 18px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
    background: oklch(0.94 0.03 80);
    border-left: 2px solid var(--ink);
  }

  /* ---------- pricing cards ---------- */
  .price-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2.4vw, 28px);
    margin: 0 0 40px;
  }
  .price-card {
    background: var(--panel);
    border: 1px solid var(--rule);
    padding: clamp(20px, 2.6vw, 28px);
  }
  .price-card h3 {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .price-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .price-card li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 14px;
  }
  .price-card li:last-child {
    border-bottom: none;
  }
  .price-card .size {
    color: var(--meta);
  }
  .price-card .price {
    color: var(--ink);
    font-weight: 500;
    white-space: nowrap;
  }

  /* ---------- add-ons ---------- */
  .addons {
    margin-top: 8px;
  }
  .addons h3 {
    margin: 0 0 18px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .addons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(20px, 3vw, 32px);
  }
  .addon {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .addon .label {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  .addon .desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--meta);
  }

  .note {
    margin: 36px 0 0;
    padding: 16px 18px;
    max-width: 60ch;
    font-size: 13px;
    line-height: 1.6;
    color: var(--meta);
    background: var(--frame-bg);
  }

  /* ---------- steps timeline ---------- */
  .timeline {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: clamp(20px, 3vw, 36px);
  }
  .num-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .num {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
  }
  .num-line {
    flex: 1 1 auto;
    width: 1px;
    margin-top: 8px;
    background: var(--rule);
  }
  .row:last-child .num-line {
    display: none;
  }
  .content-col {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.6vw, 28px);
    padding-bottom: clamp(32px, 4.5vw, 56px);
  }
  .row:last-child .content-col {
    padding-bottom: 0;
  }
  .block h3 {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  .block p {
    margin: 0;
    max-width: 62ch;
    font-size: 13px;
    line-height: 1.7;
    color: var(--meta);
    white-space: pre-line;
  }

  @media (max-width: 560px) {
    .price-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
