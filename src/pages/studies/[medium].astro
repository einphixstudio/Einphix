---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import MediaSwitcher from '../../components/MediaSwitcher.astro';
import WorkRail from '../../components/WorkRail.astro';
import { getStudyMedia, getStudiesByMediumSlug } from '../../lib/studies';

export async function getStaticPaths() {
  const media = await getStudyMedia();
  return Promise.all(
    media.map(async (medium) => ({
      params: { medium: medium.slug },
      props: { medium, studies: await getStudiesByMediumSlug(medium.slug) },
    })),
  );
}

const { medium, studies } = Astro.props;
const media = await getStudyMedia();
---

<Layout title={`Einphix — Studies / ${medium.label}`} fitViewportDesktopOnly>
  <SiteHeader current="studies" />
  <main>
    <MediaSwitcher media={media} currentSlug={medium.slug} />
    {studies.length > 0 && <WorkRail works={studies} />}
  </main>
</Layout>

<style>
  main {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    cursor: grab;
  }
  main:global(.dragging) {
    cursor: grabbing;
  }

  @media (max-width: 899px) {
    main {
      justify-content: flex-start;
      overflow: visible;
      cursor: default;
    }
  }
</style>
