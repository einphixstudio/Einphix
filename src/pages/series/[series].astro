---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SeriesSwitcher from '../../components/SeriesSwitcher.astro';
import WorkRail from '../../components/WorkRail.astro';
import { getSeriesList, getWorksBySeriesSlug } from '../../lib/series';

export async function getStaticPaths() {
  const series = await getSeriesList();
  return Promise.all(
    series.map(async (s) => ({
      params: { series: s.slug },
      props: { series: s, works: await getWorksBySeriesSlug(s.slug) },
    })),
  );
}

const { series, works } = Astro.props;
const seriesList = await getSeriesList();
---

<Layout title={`Einphix — Series / ${series.label}`} fitViewportDesktopOnly>
  <SiteHeader current="series" />
  <main>
    <SeriesSwitcher series={seriesList} currentSlug={series.slug} />
    {works.length > 0 && <WorkRail works={works} />}
  </main>
</Layout>

<style>
  main {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    cursor: grab;
  }
  main:global(.dragging) {
    cursor: grabbing;
  }

  @media (max-width: 899px) {
    main {
      justify-content: flex-start;
      overflow: visible;
      cursor: default;
    }
  }
</style>
