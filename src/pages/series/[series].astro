---
import '@fontsource/hanken-grotesk/800.css';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import WorkRail from '../../components/WorkRail.astro';
import { getSeriesList, getWorksBySeriesSlug, getSeriesDescription } from '../../lib/series';

export async function getStaticPaths() {
  const series = await getSeriesList();
  return Promise.all(
    series.map(async (s) => ({
      params: { series: s.slug },
      props: { series: s, works: await getWorksBySeriesSlug(s.slug) },
    })),
  );
}

const { series, works } = Astro.props;
const description = await getSeriesDescription(series.slug);
---

<Layout title={`Einphix — Series / ${series.label}`} fitViewportDesktopOnly>
  <SiteHeader current="series" />
  <div class="series-head">
    <h1>{series.label}</h1>
    {description && <p class="description">{description}</p>}
  </div>
  <main>
    {works.length > 0 && <WorkRail works={works} />}
  </main>
</Layout>

<style>
  .series-head {
    flex: 0 0 auto;
    padding: clamp(32px, 5vw, 64px) var(--pad-x) 0;
  }
  h1 {
    margin: 0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(34px, 4.6vw, 52px);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .description {
    margin: 14px 0 0;
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.65;
    color: var(--meta);
  }

  main {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    cursor: grab;
  }
  main:global(.dragging) {
    cursor: grabbing;
  }

  @media (max-width: 899px) {
    main {
      justify-content: flex-start;
      overflow: visible;
      cursor: default;
    }
  }
</style>
