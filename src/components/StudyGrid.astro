---
import { Picture, getImage } from 'astro:assets';
import { studyCaption } from '../lib/studies';
import type { Work } from '../lib/works';

interface Props {
  studies: Work[];
}

const { studies } = Astro.props;

// One larger rendition per piece for the lightbox — the grid thumbnails
// below are optimized small. Skipped for a work whose image file is
// missing (see content.config.ts); its tile shows a placeholder instead.
const lightboxImages = await Promise.all(
  studies.map((s) => (s.data.image ? getImage({ src: s.data.image, width: 1600, format: 'webp' }) : undefined)),
);
---

<div class="grid" data-grid>
  {studies.map((s, i) => (
    <a class="tile" href="#" data-idx={i}>
      {s.data.image ? (
        <Picture
          src={s.data.image}
          alt={s.data.title}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          width={640}
          loading={i < 6 ? 'eager' : 'lazy'}
          draggable="false"
        />
      ) : (
        <div class="missing">Image missing</div>
      )}
    </a>
  ))}
  <span class="tile-data" hidden>
    {studies.map((s, i) => (
      <span data-title={s.data.title} data-meta={studyCaption(s)} data-full={lightboxImages[i]?.src ?? ''} />
    ))}
  </span>
</div>

{studies.length === 0 && <p class="empty">No studies here yet.</p>}

<div class="lightbox" data-open="false" role="dialog" aria-modal="true" aria-label="Study" data-lightbox>
  <figure>
    <img alt="" data-lb-img />
    <figcaption>
      <span class="title" data-lb-title></span>
      <span class="meta" data-lb-meta></span>
    </figcaption>
  </figure>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous" data-lb-prev>&lsaquo;</button>
  <button class="lb-btn lb-next" type="button" aria-label="Next" data-lb-next>&rsaquo;</button>
  <button class="lb-btn lb-close" type="button" aria-label="Close" data-lb-close>&#10005;</button>
</div>

<style>
  .grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 16px;
    padding: 0 var(--pad-x) clamp(40px, 6vw, 80px);
  }
  .tile {
    display: block;
    height: clamp(140px, 22vw, 200px);
    background: transparent;
    overflow: hidden;
  }
  .tile :global(picture) {
    display: block;
    height: 100%;
  }
  .tile :global(img) {
    display: block;
    width: auto;
    max-width: 360px;
    height: 100%;
    object-fit: contain;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tile:hover :global(img) {
    transform: scale(1.03);
  }
  .tile .missing {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 220px;
    height: 100%;
    color: var(--meta);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
  }
  .empty {
    padding: 0 var(--pad-x) clamp(40px, 6vw, 80px);
    color: var(--meta);
    font-size: 14px;
  }

  /* ---------- lightbox (same visual language as the Work rail's) ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 4vw, 60px);
    background: oklch(0.968 0.004 85 / 0.9);
    animation: gridFadeIn 220ms ease both;
  }
  .lightbox[data-open='true'] {
    display: flex;
  }
  .lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-height: 100%;
  }
  .lightbox img {
    max-height: 82vh;
    max-width: min(1100px, 82vw);
    width: auto;
    height: auto;
    display: block;
    box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 0.5);
  }
  .lightbox figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 5px;
  }
  .lightbox .title {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .lightbox .meta {
    font-size: 12px;
    color: var(--meta);
  }
  .lb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    color: oklch(0.3 0.006 80);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 200ms;
  }
  .lb-btn:hover {
    opacity: 1;
  }
  .lb-prev {
    top: 50%;
    left: clamp(12px, 2vw, 34px);
    transform: translateY(-50%);
  }
  .lb-next {
    top: 50%;
    right: clamp(12px, 2vw, 34px);
    transform: translateY(-50%);
  }
  .lb-close {
    top: clamp(14px, 2vw, 28px);
    right: clamp(14px, 2vw, 30px);
    width: 40px;
    height: 40px;
    font-size: 20px;
    opacity: 0.6;
  }

  @keyframes gridFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile :global(img) {
      transition: none;
    }
    .lightbox {
      animation: none;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  if (grid && lightbox) {
    const lbImg = lightbox.querySelector<HTMLImageElement>('[data-lb-img]');
    const lbTitle = lightbox.querySelector<HTMLElement>('[data-lb-title]');
    const lbMeta = lightbox.querySelector<HTMLElement>('[data-lb-meta]');

    interface Entry {
      title: string;
      meta: string;
      full: string;
    }
    const entries: Entry[] = [...document.querySelectorAll<HTMLElement>('.tile-data > span')].map(
      (el) => ({
        title: el.dataset.title ?? '',
        meta: el.dataset.meta ?? '',
        full: el.dataset.full ?? '',
      }),
    );
    let at = -1;

    function show(i: number) {
      if (!lbImg || !lbTitle || !lbMeta || entries.length === 0) return;
      at = (i + entries.length) % entries.length;
      const e = entries[at];
      if (!e.full) return;
      lbImg.src = e.full;
      lbImg.alt = e.title;
      lbTitle.textContent = e.title;
      lbMeta.textContent = e.meta;
      lightbox!.dataset.open = 'true';
    }
    function close() {
      lightbox!.dataset.open = 'false';
      at = -1;
    }

    grid.addEventListener('click', (e) => {
      const tile = (e.target as HTMLElement).closest<HTMLElement>('.tile');
      if (!tile) return;
      e.preventDefault();
      const idx = Number(tile.dataset.idx);
      if (!Number.isNaN(idx)) show(idx);
    });

    lightbox.querySelector('[data-lb-prev]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(at - 1);
    });
    lightbox.querySelector('[data-lb-next]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(at + 1);
    });
    lightbox.querySelector('[data-lb-close]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      close();
    });

    // Empty space left of the image = previous, right = next.
    lightbox.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('figure') || target.closest('button')) return;
      const r = lightbox!.querySelector('figure')!.getBoundingClientRect();
      show((e as MouseEvent).clientX < r.left + r.width / 2 ? at - 1 : at + 1);
    });

    window.addEventListener('keydown', (e) => {
      if (lightbox!.dataset.open !== 'true') return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') show(at + 1);
      else if (e.key === 'ArrowLeft') show(at - 1);
    });
  }
</script>
