---
import { Image, getImage } from 'astro:assets';
import { workYearCaptionLine2 } from '../lib/workBuckets';
import type { Work } from '../lib/works';

interface Props {
  works: Work[];
}

const { works } = Astro.props;

// One larger rendition per work for the single-artwork (lightbox) view —
// the rail's own <Image> below is optimized small, for the thumbnail rail.
// Skipped for a work whose image file is missing (see content.config.ts);
// its plate shows a placeholder instead and can't be opened in the lightbox.
const lightboxImages = await Promise.all(
  works.map((work) => (work.data.image ? getImage({ src: work.data.image, width: 1600, format: 'webp' }) : undefined)),
);
---

<div class="rail-wrap">
  <div class="track" data-track>
    <div class="row" data-row>
      {works.map((work, i) => (
        <figure>
          <a
            class="plate"
            href="#"
            data-idx={i}
            style={work.data.image ? `aspect-ratio: ${work.data.image.width} / ${work.data.image.height};` : 'aspect-ratio: 3 / 4;'}
          >
            {work.data.image ? (
              <Image
                src={work.data.image}
                alt={work.data.title}
                height={560}
                densities={[1, 2]}
                loading={i < 2 ? 'eager' : 'lazy'}
                draggable="false"
              />
            ) : (
              <div class="missing">Image missing</div>
            )}
          </a>
          <figcaption>
            <span class="title" data-title>{work.data.title}</span>
            <span class="meta" data-meta>{workYearCaptionLine2(work)}</span>
          </figcaption>
          <span class="plate-data" data-full={lightboxImages[i]?.src ?? ''} data-alt={work.data.title} hidden></span>
        </figure>
      ))}
    </div>
  </div>

  <button class="rail-btn rail-prev" type="button" aria-label="Previous" data-rail-prev>&lsaquo;</button>
  <button class="rail-btn rail-next" type="button" aria-label="Next" data-rail-next>&rsaquo;</button>
</div>

<div class="lightbox" data-open="false" role="dialog" aria-modal="true" aria-label="Artwork" data-lightbox>
  <figure>
    <img alt="" data-lb-img />
    <figcaption>
      <span class="title" data-lb-title></span>
      <span class="meta" data-lb-meta></span>
    </figcaption>
  </figure>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous" data-lb-prev>&lsaquo;</button>
  <button class="lb-btn lb-next" type="button" aria-label="Next" data-lb-next>&rsaquo;</button>
  <button class="lb-btn lb-close" type="button" aria-label="Close" data-lb-close>&#10005;</button>
</div>

<style>
  .rail-wrap {
    display: flex;
    justify-content: flex-start;
  }
  /* Not enough works to need scrolling — center the row instead of
     leaving it flush against the left padding. */
  .rail-wrap[data-centered='true'] {
    justify-content: center;
  }
  .track {
    display: flex;
    align-items: flex-start;
    flex: 0 0 auto;
    will-change: transform;
  }
  .row {
    --gap: 16px;
    display: flex;
    align-items: flex-start;
    flex: 0 0 auto;
    gap: var(--gap);
    padding-left: var(--pad-x);
    padding-right: var(--gap);
  }
  figure {
    margin: 0;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
  }
  .plate {
    --plate-h: clamp(280px, 46vh, 560px);
    display: block;
    height: var(--plate-h);
    overflow: hidden;
    background: var(--frame-bg);
  }
  .plate img {
    height: 100%;
    width: auto;
    display: block;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .plate:hover img {
    transform: scale(1.03);
  }
  .plate .missing {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--meta);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
  }
  figcaption {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .title {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .meta {
    font-size: 12px;
    letter-spacing: 0.01em;
    color: var(--meta);
  }

  .rail-btn {
    position: absolute;
    top: 50%;
    transform: translateY(calc(-50% + 22px));
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 46px;
    padding: 0 10px;
    background: oklch(0.16 0.004 80);
    border: none;
    color: oklch(0.98 0 0);
    font-size: 16px;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 200ms;
  }
  .rail-btn:hover {
    opacity: 0.95;
  }
  .rail-btn[data-visible='false'] {
    display: none;
  }
  .rail-prev[data-disabled='true'] {
    opacity: 0.2;
    pointer-events: none;
  }
  .rail-prev {
    left: 0;
  }
  .rail-next {
    right: 0;
  }
  .rail-next[data-state='end'] {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0 16px;
  }

  /* ---------- mobile: vertical stack instead of a horizontal drag rail ---------- */
  @media (max-width: 899px) {
    .rail-wrap {
      display: block;
    }
    .track {
      display: block;
    }
    .row {
      display: block;
      padding-left: 0;
      padding-right: 0;
    }
    figure {
      display: block;
      margin-bottom: clamp(36px, 8vw, 56px);
    }
    figure:last-child {
      margin-bottom: 0;
    }
    figcaption {
      padding: 0 var(--pad-x);
    }
    .plate {
      height: auto;
      width: 100%;
      overflow: visible;
    }
    .plate img {
      width: 100%;
      height: auto;
    }
    .plate .missing {
      aspect-ratio: 4 / 5;
      height: auto;
    }
    .rail-btn {
      display: none;
    }
  }

  /* ---------- lightbox ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 4vw, 60px);
    background: oklch(0.968 0.004 85 / 0.9);
    animation: railFadeIn 220ms ease both;
  }
  .lightbox[data-open='true'] {
    display: flex;
  }
  .lightbox figure {
    align-items: center;
    gap: 16px;
    max-height: 100%;
  }
  .lightbox img {
    max-height: 82vh;
    max-width: min(1100px, 82vw);
    width: auto;
    height: auto;
    display: block;
    box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 0.5);
  }
  .lightbox figcaption {
    margin-top: 0;
    align-items: center;
    text-align: center;
    gap: 5px;
  }
  .lightbox .title {
    font-size: 12px;
    letter-spacing: 0.18em;
  }
  .lb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    color: oklch(0.3 0.006 80);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 200ms;
  }
  .lb-btn:hover {
    opacity: 1;
  }
  .lb-prev {
    top: 50%;
    left: clamp(12px, 2vw, 34px);
    transform: translateY(-50%);
  }
  .lb-next {
    top: 50%;
    right: clamp(12px, 2vw, 34px);
    transform: translateY(-50%);
  }
  .lb-close {
    top: clamp(14px, 2vw, 28px);
    right: clamp(14px, 2vw, 30px);
    width: 40px;
    height: 40px;
    font-size: 20px;
    opacity: 0.6;
  }

  @keyframes railFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plate img {
      transition: none;
    }
    .lightbox {
      animation: none;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('main');
  const railWrap = document.querySelector<HTMLElement>('.rail-wrap');
  const track = document.querySelector<HTMLElement>('[data-track]');
  const row = document.querySelector<HTMLElement>('[data-row]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-rail-next]');
  if (stage && railWrap && track && row && prevBtn && nextBtn) {
    const GAP = 16;
    const WHEEL = 1.1;
    const EASE = 0.14;
    const EPS = 1;

    let pos = 0;
    let target = 0;
    let maxScroll = 0;
    let cardStep = 320;
    let running = false;

    // Checked live (not cached) so the rail stands down correctly even if
    // the viewport crosses the breakpoint after load (e.g. resizing).
    function isMobile() {
      return window.matchMedia('(max-width: 899px)').matches;
    }
    function clamp(v: number) {
      return Math.max(0, Math.min(v, maxScroll));
    }
    function atStart() {
      return target <= EPS;
    }
    function atEnd() {
      return maxScroll > 0 && target >= maxScroll - EPS;
    }
    function updateButtons() {
      const scrollable = maxScroll > 0;
      prevBtn!.dataset.visible = String(scrollable);
      nextBtn!.dataset.visible = String(scrollable);
      prevBtn!.dataset.disabled = String(atStart());
      if (atEnd()) {
        nextBtn!.dataset.state = 'end';
        nextBtn!.textContent = 'Back to Start';
        nextBtn!.setAttribute('aria-label', 'Back to start');
      } else {
        nextBtn!.dataset.state = '';
        nextBtn!.textContent = '›';
        nextBtn!.setAttribute('aria-label', 'Next');
      }
    }

    // A long, unwrapped title is wider than a narrow (portrait) image, and
    // since figcaption has no width of its own, a flex column container
    // sizes itself (and the `.plate` sibling that fills its width) to that
    // title's full width instead of the image's — exposing `.plate`'s grey
    // background down one side. Capping each caption's max-width to its own
    // plate's true (aspect-ratio-derived) width makes the caption wrap
    // instead, and lets the plate settle back to the image's real size.
    function syncCaptionWidths() {
      row!.querySelectorAll<HTMLElement>('figure').forEach((fig) => {
        const plate = fig.querySelector<HTMLElement>('.plate');
        const figcaption = fig.querySelector<HTMLElement>('figcaption');
        const match = plate?.getAttribute('style')?.match(/aspect-ratio:\s*([\d.]+)\s*\/\s*([\d.]+)/);
        if (!plate || !figcaption || !match) return;
        const ratio = parseFloat(match[1]) / parseFloat(match[2]);
        const plateHeight = plate.getBoundingClientRect().height;
        figcaption.style.maxWidth = `${plateHeight * ratio}px`;
      });
    }

    function measure() {
      syncCaptionWidths();
      const w = row!.getBoundingClientRect().width;
      if (!w) return;
      const stageW = stage!.getBoundingClientRect().width;
      maxScroll = Math.max(0, w - stageW);
      railWrap!.dataset.centered = String(maxScroll <= 0);
      target = clamp(target);
      pos = clamp(pos);
      const card = row!.firstElementChild as HTMLElement | null;
      cardStep = card ? card.offsetWidth + GAP : 320;
      apply();
      updateButtons();
    }
    function apply() {
      if (isMobile()) {
        track!.style.transform = '';
        return;
      }
      track!.style.transform = `translateX(${-pos}px)`;
    }
    function run() {
      updateButtons();
      if (running) return;
      running = true;
      const tick = () => {
        const d = target - pos;
        if (Math.abs(d) < 0.4) {
          pos = target;
          running = false;
          apply();
          return;
        }
        pos += d * EASE;
        apply();
        requestAnimationFrame(tick);
      };
      tick();
    }
    // The rail no longer loops — it stops at the last card, and the "next"
    // button turns into "Back to Start" instead of wrapping around.
    function goNext() {
      target = atEnd() ? 0 : clamp(target + cardStep);
      run();
    }
    function goPrev() {
      target = clamp(target - cardStep);
      run();
    }

    // Every plate carries its own aspect-ratio (baked in server-side from the
    // image's real dimensions), so — unlike a framework-free page — geometry
    // is correct at first layout and we don't need to wait for img `load`
    // events before measuring.
    measure();
    window.addEventListener('resize', measure);
    if (window.ResizeObserver) new ResizeObserver(measure).observe(row);

    const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
    const lbImg = lightbox?.querySelector<HTMLImageElement>('[data-lb-img]');
    const lbTitle = lightbox?.querySelector<HTMLElement>('[data-lb-title]');
    const lbMeta = lightbox?.querySelector<HTMLElement>('[data-lb-meta]');

    stage.addEventListener(
      'wheel',
      (e) => {
        if (isMobile()) return;
        e.preventDefault();
        if (lightbox?.dataset.open === 'true') return;
        const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        target = clamp(target + d * WHEEL);
        run();
      },
      { passive: false },
    );

    let drag: { x: number; s: number } | null = null;
    let moved = 0;
    stage.addEventListener('pointerdown', (e) => {
      if (isMobile()) return;
      drag = { x: e.clientX, s: target };
      moved = 0;
      stage.classList.add('dragging');
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      moved = Math.abs(e.clientX - drag.x);
      target = clamp(drag.s + (drag.x - e.clientX));
      run();
    });
    window.addEventListener('pointerup', () => {
      drag = null;
      stage.classList.remove('dragging');
    });

    prevBtn.addEventListener('click', () => goPrev());
    nextBtn.addEventListener('click', () => goNext());

    // ---------- lightbox ----------
    interface WorkEntry {
      title: string;
      meta: string;
      full: string;
      alt: string;
    }
    const entries: WorkEntry[] = [...row.querySelectorAll<HTMLElement>('figure')].map((fig) => {
      const data = fig.querySelector<HTMLElement>('.plate-data')!;
      return {
        title: fig.querySelector<HTMLElement>('[data-title]')!.textContent ?? '',
        meta: fig.querySelector<HTMLElement>('[data-meta]')!.textContent ?? '',
        full: data.dataset.full ?? '',
        alt: data.dataset.alt ?? '',
      };
    });
    let at = -1;

    function show(i: number) {
      if (!lightbox || !lbImg || !lbTitle || !lbMeta || entries.length === 0) return;
      at = (i + entries.length) % entries.length;
      const w = entries[at];
      if (!w.full) return;
      lbImg.src = w.full;
      lbImg.alt = w.alt;
      lbTitle.textContent = w.title;
      lbMeta.textContent = w.meta;
      lightbox.dataset.open = 'true';
    }
    function close() {
      if (!lightbox) return;
      lightbox.dataset.open = 'false';
      at = -1;
    }

    // Click a plate to open — suppressed if the pointer was dragging.
    track.addEventListener('click', (e) => {
      if (moved > 6) return;
      const plate = (e.target as HTMLElement).closest<HTMLElement>('.plate');
      if (!plate) return;
      e.preventDefault();
      const idx = Number(plate.dataset.idx);
      if (!Number.isNaN(idx)) show(idx);
    });

    lightbox?.querySelector('[data-lb-prev]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(at - 1);
    });
    lightbox?.querySelector('[data-lb-next]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(at + 1);
    });
    lightbox?.querySelector('[data-lb-close]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      close();
    });

    // Empty space left of the plate = previous, right = next.
    lightbox?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('figure') || target.closest('button')) return;
      const r = lightbox.querySelector('figure')!.getBoundingClientRect();
      show((e as MouseEvent).clientX < r.left + r.width / 2 ? at - 1 : at + 1);
    });

    window.addEventListener('keydown', (e) => {
      if (lightbox?.dataset.open === 'true') {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(at + 1);
        else if (e.key === 'ArrowLeft') show(at - 1);
        return;
      }
      if (e.key === 'ArrowRight') goNext();
      else if (e.key === 'ArrowLeft') goPrev();
    });
  }
</script>
