---
import { Image, getImage } from 'astro:assets';
import { workYearCaptionLine2 } from '../lib/workBuckets';
import type { Work } from '../lib/works';

interface Props {
  works: Work[];
}

const { works } = Astro.props;

// One larger rendition per work for the single-artwork (lightbox) view —
// the rail's own <Image> below is optimized small, for the thumbnail rail.
const lightboxImages = await Promise.all(
  works.map((work) => getImage({ src: work.data.image, width: 1600, format: 'webp' })),
);
---

<div class="rail-wrap">
  <div class="track" data-track>
    <div class="row" data-row>
      {works.map((work, i) => (
        <figure>
          <a
            class="plate"
            href="#"
            data-idx={i}
            style={`aspect-ratio: ${work.data.image.width} / ${work.data.image.height};`}
          >
            <Image
              src={work.data.image}
              alt={work.data.title}
              height={560}
              densities={[1, 2]}
              loading={i < 2 ? 'eager' : 'lazy'}
              draggable="false"
            />
          </a>
          <figcaption>
            <span class="title" data-title>{work.data.title}</span>
            <span class="meta" data-meta>{workYearCaptionLine2(work)}</span>
          </figcaption>
          <span class="plate-data" data-full={lightboxImages[i].src} data-alt={work.data.title} hidden></span>
        </figure>
      ))}
    </div>
  </div>

  <button class="rail-btn rail-prev" type="button" aria-label="Previous" data-rail-prev>&lsaquo;</button>
  <button class="rail-btn rail-next" type="button" aria-label="Next" data-rail-next>&rsaquo;</button>
</div>

<div class="lightbox" data-open="false" role="dialog" aria-modal="true" aria-label="Artwork" data-lightbox>
  <figure>
    <img alt="" data-lb-img />
    <figcaption>
      <span class="title" data-lb-title></span>
      <span class="meta" data-lb-meta></span>
    </figcaption>
  </figure>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous" data-lb-prev>&lsaquo;</button>
  <button class="lb-btn lb-next" type="button" aria-label="Next" data-lb-next>&rsaquo;</button>
  <button class="lb-btn lb-close" type="button" aria-label="Close" data-lb-close>&#10005;</button>
</div>

<style>
  .track {
    display: flex;
    align-items: flex-start;
    flex: 0 0 auto;
    will-change: transform;
  }
  .row {
    --gap: 16px;
    display: flex;
    align-items: flex-start;
    flex: 0 0 auto;
    gap: var(--gap);
    padding-right: var(--gap);
  }
  figure {
    margin: 0;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
  }
  .plate {
    --plate-h: clamp(280px, 46vh, 560px);
    display: block;
    height: var(--plate-h);
    overflow: hidden;
    background: var(--frame-bg);
  }
  .plate img {
    height: 100%;
    width: auto;
    display: block;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .plate:hover img {
    transform: scale(1.03);
  }
  figcaption {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .title {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .meta {
    font-size: 12px;
    letter-spacing: 0.01em;
    color: var(--meta);
  }

  .rail-btn {
    position: absolute;
    top: 50%;
    transform: translateY(calc(-50% + 22px));
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 46px;
    background: oklch(0.16 0.004 80);
    border: none;
    color: oklch(0.98 0 0);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 200ms;
  }
  .rail-btn:hover {
    opacity: 0.95;
  }
  .rail-prev {
    left: 0;
  }
  .rail-next {
    right: 0;
  }

  /* ---------- lightbox ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 4vw, 60px);
    background: oklch(0.968 0.004 85 / 0.9);
    animation: railFadeIn 220ms ease both;
  }
  .lightbox[data-open='true'] {
    display: flex;
  }
  .lightbox figure {
    align-items: center;
    gap: 16px;
    max-height: 100%;
  }
  .lightbox img {
    max-height: 82vh;
    max-width: min(1100px, 82vw);
    width: auto;
    height: auto;
    display: block;
    box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 0.5);
  }
  .lightbox figcaption {
    margin-top: 0;
    align-items: center;
    text-align: center;
    gap: 5px;
  }
  .lightbox .title {
    font-size: 12px;
    letter-spacing: 0.18em;
  }
  .lb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    color: oklch(0.3 0.006 80);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 200ms;
  }
  .lb-btn:hover {
    opacity: 1;
  }
  .lb-prev {
    top: 50%;
    left: clamp(12px, 2vw, 34px);
    transform: translateY(-50%);
  }
  .lb-next {
    top: 50%;
    right: clamp(12px, 2vw, 34px);
    transform: translateY(-50%);
  }
  .lb-close {
    top: clamp(14px, 2vw, 28px);
    right: clamp(14px, 2vw, 30px);
    width: 40px;
    height: 40px;
    font-size: 20px;
    opacity: 0.6;
  }

  @keyframes railFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plate img {
      transition: none;
    }
    .lightbox {
      animation: none;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('main');
  const track = document.querySelector<HTMLElement>('[data-track]');
  const row = document.querySelector<HTMLElement>('[data-row]');
  if (stage && track && row) {
    const GAP = 16;
    const WHEEL = 1.1;
    const EASE = 0.14;

    // The authored row is cloned 3× so the rail wraps seamlessly in both directions.
    for (let i = 0; i < 3; i++) {
      const clone = row.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    }

    let pos = 0;
    let target = 0;
    let W = 0;
    let cardStep = 320;
    let running = false;

    function measure() {
      const w = row!.getBoundingClientRect().width;
      if (!w) return;
      W = w;
      const card = row!.firstElementChild as HTMLElement | null;
      cardStep = card ? card.offsetWidth + GAP : 320;
      apply();
    }
    function wrap(x: number) {
      if (!W) return x;
      const m = ((x % W) + W) % W;
      return m === 0 ? 0 : m - W;
    }
    function apply() {
      track!.style.transform = `translateX(${-W + wrap(pos)}px)`;
    }
    function run() {
      if (running) return;
      running = true;
      const tick = () => {
        const d = target - pos;
        if (Math.abs(d) < 0.4) {
          pos = target;
          running = false;
          apply();
          return;
        }
        pos += d * EASE;
        apply();
        requestAnimationFrame(tick);
      };
      tick();
    }
    function nudge(dir: number) {
      target += dir * cardStep;
      run();
    }

    // Every plate carries its own aspect-ratio (baked in server-side from the
    // image's real dimensions), so — unlike a framework-free page — geometry
    // is correct at first layout and we don't need to wait for img `load`
    // events before measuring.
    measure();
    window.addEventListener('resize', measure);
    if (window.ResizeObserver) new ResizeObserver(measure).observe(row);

    const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
    const lbImg = lightbox?.querySelector<HTMLImageElement>('[data-lb-img]');
    const lbTitle = lightbox?.querySelector<HTMLElement>('[data-lb-title]');
    const lbMeta = lightbox?.querySelector<HTMLElement>('[data-lb-meta]');

    stage.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        if (lightbox?.dataset.open === 'true') return;
        const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        target -= d * WHEEL;
        run();
      },
      { passive: false },
    );

    let drag: { x: number; t: number } | null = null;
    let moved = 0;
    stage.addEventListener('pointerdown', (e) => {
      drag = { x: e.clientX, t: target };
      moved = 0;
      stage.classList.add('dragging');
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      moved = Math.abs(e.clientX - drag.x);
      target = drag.t + (e.clientX - drag.x);
      run();
    });
    window.addEventListener('pointerup', () => {
      drag = null;
      stage.classList.remove('dragging');
    });

    document.querySelector('[data-rail-prev]')?.addEventListener('click', () => nudge(1));
    document.querySelector('[data-rail-next]')?.addEventListener('click', () => nudge(-1));

    // ---------- lightbox ----------
    interface WorkEntry {
      title: string;
      meta: string;
      full: string;
      alt: string;
    }
    const entries: WorkEntry[] = [...row.querySelectorAll<HTMLElement>('figure')].map((fig) => {
      const data = fig.querySelector<HTMLElement>('.plate-data')!;
      return {
        title: fig.querySelector<HTMLElement>('[data-title]')!.textContent ?? '',
        meta: fig.querySelector<HTMLElement>('[data-meta]')!.textContent ?? '',
        full: data.dataset.full ?? '',
        alt: data.dataset.alt ?? '',
      };
    });
    let at = -1;

    function show(i: number) {
      if (!lightbox || !lbImg || !lbTitle || !lbMeta || entries.length === 0) return;
      at = (i + entries.length) % entries.length;
      const w = entries[at];
      lbImg.src = w.full;
      lbImg.alt = w.alt;
      lbTitle.textContent = w.title;
      lbMeta.textContent = w.meta;
      lightbox.dataset.open = 'true';
    }
    function close() {
      if (!lightbox) return;
      lightbox.dataset.open = 'false';
      at = -1;
    }

    // Click a plate to open — suppressed if the pointer was dragging.
    track.addEventListener('click', (e) => {
      if (moved > 6) return;
      const plate = (e.target as HTMLElement).closest<HTMLElement>('.plate');
      if (!plate) return;
      e.preventDefault();
      const idx = Number(plate.dataset.idx);
      if (!Number.isNaN(idx)) show(idx);
    });

    lightbox?.querySelector('[data-lb-prev]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(at - 1);
    });
    lightbox?.querySelector('[data-lb-next]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(at + 1);
    });
    lightbox?.querySelector('[data-lb-close]')?.addEventListener('click', (e) => {
      e.stopPropagation();
      close();
    });

    // Empty space left of the plate = previous, right = next.
    lightbox?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('figure') || target.closest('button')) return;
      const r = lightbox.querySelector('figure')!.getBoundingClientRect();
      show((e as MouseEvent).clientX < r.left + r.width / 2 ? at - 1 : at + 1);
    });

    window.addEventListener('keydown', (e) => {
      if (lightbox?.dataset.open === 'true') {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(at + 1);
        else if (e.key === 'ArrowLeft') show(at - 1);
        return;
      }
      if (e.key === 'ArrowRight') nudge(-1);
      else if (e.key === 'ArrowLeft') nudge(1);
    });
  }
</script>
