---
import { Picture } from 'astro:assets';
import { captionLine2, type Work } from '../lib/works';

interface Props {
  works: Work[];
}

const { works } = Astro.props;
---

<main>
  <div class="stack" data-carousel>
    {works.map((work, i) => (
      <figure class="work" data-active={i === 0 ? 'true' : 'false'}>
        <div class="plate">
          <Picture
            src={work.data.image}
            alt={work.data.title}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            widths={[640, 1200, 1920]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </div>
        <figcaption>
          <span>{work.data.title}</span>
          <span>{captionLine2(work)}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</main>

<style>
  main {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    justify-content: center;
    align-items: stretch;
    padding: clamp(10px, 2vw, 28px) var(--pad-x) clamp(28px, 4vw, 52px);
  }
  .stack {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
  }
  .work {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 900ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .work[data-active='true'] {
    opacity: 1;
  }
  /* .plate and picture take no box of their own (display: contents), so the
     img sizes itself directly against .work (a definite height, from the
     grid stretch above): the whole painting is always visible — shrunk to
     fit width and/or height, never cropped — and the reserved 64px keeps
     room for the caption so it never overlaps. Frame background and shadow
     live on the img itself so they hug its actual rendered size, and
     justify/align-content on .work centers the image (and caption) as a
     group in whatever space is left over. */
  .work .plate,
  .work .plate picture {
    display: contents;
  }
  .work .plate img {
    display: block;
    max-width: 100%;
    max-height: calc(100% - 64px);
    width: auto;
    height: auto;
    background: var(--frame-bg);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.45);
  }
  .work figcaption {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .work figcaption span {
    font-size: 15px;
    letter-spacing: 0.01em;
  }

  @media (prefers-reduced-motion: reduce) {
    .work {
      transition: none;
    }
  }
</style>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>('.work')];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (slides.length > 1 && !reducedMotion) {
    let i = 0;
    setInterval(() => {
      slides[i].dataset.active = 'false';
      i = (i + 1) % slides.length;
      slides[i].dataset.active = 'true';
    }, 5000);
  }
</script>
