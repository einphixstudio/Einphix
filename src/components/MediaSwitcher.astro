---
import type { StudyMedium } from '../lib/studies';

interface Props {
  media: StudyMedium[];
  currentSlug?: string;
}

const { media, currentSlug } = Astro.props;
---

<div class="media-switcher">
  <nav>
    <a href="/studies" aria-current={currentSlug === undefined ? 'page' : undefined}>All</a>
    {media.map((m) => (
      <a href={`/studies/${m.slug}`} aria-current={m.slug === currentSlug ? 'page' : undefined}>
        {m.label}
      </a>
    ))}
  </nav>
</div>

<style>
  .media-switcher {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
    padding: 0 var(--pad-x) 20px;
  }
  .media-switcher nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: clamp(12px, 1.4vw, 20px);
  }
  .media-switcher a {
    padding: 4px 0;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--meta);
    border-bottom: 1px solid transparent;
    transition: color 220ms, border-color 220ms;
  }
  .media-switcher a:hover {
    color: oklch(0.2 0.006 80);
  }
  .media-switcher a[aria-current='page'] {
    color: oklch(0.2 0.006 80);
    border-bottom-color: oklch(0.2 0.006 80);
  }
</style>
